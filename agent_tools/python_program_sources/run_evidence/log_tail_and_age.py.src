import base64
import json
import shlex
import subprocess
import sys

path, lines = sys.argv[1:]
commands = [
    ["tail", "-n", lines, path],
    ["sh", "-c", "now=$(date +%s); m=$(stat -c %Y " + shlex.quote(path) + " 2>/dev/null) || exit 1; echo $((now-m))"],
]
results = []
for command in commands:
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    results.append([
        result.returncode,
        base64.b64encode(result.stdout).decode("ascii"),
        base64.b64encode(result.stderr).decode("ascii"),
    ])
print(json.dumps(results))
