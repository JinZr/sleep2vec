from datetime import datetime, timezone
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time
import traceback


def option(name):
    positions = [index for index, value in enumerate(sys.argv) if value == name]
    if len(positions) != 1 or positions[0] + 1 >= len(sys.argv):
        raise ValueError(f"Slurm bootstrap requires one {name} value.")
    return sys.argv[positions[0] + 1]


def utc_now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


result_path = option("--result-path")
submit_token = option("--submit-token")
started_at = utc_now()
received_signal = 0
child = None


def forward_signal(signum, _frame):
    global received_signal
    received_signal = signum
    if child is not None and child.poll() is None:
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass


def write_terminal(exit_code):
    target = Path(result_path)
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.parent / f".{target.name}.{os.getpid()}.{time.time_ns()}.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w") as file_obj:
            json.dump(
                {
                    "schema_version": 1,
                    "scheduler_job_id": str(os.environ.get("SLURM_JOB_ID") or ""),
                    "scheduler_cluster": str(os.environ.get("SLURM_CLUSTER_NAME") or ""),
                    "scheduler_submit_token": submit_token,
                    "node": socket.gethostname(),
                    "started_at": started_at,
                    "ended_at": utc_now(),
                    "exit_code": exit_code,
                    "runtime_commit": "",
                },
                file_obj,
                sort_keys=True,
            )
            file_obj.write("\n")
            file_obj.flush()
            os.fsync(file_obj.fileno())
        try:
            os.link(temporary, target)
        except FileExistsError:
            pass
    finally:
        temporary.unlink(missing_ok=True)


forwarded_signals = (signal.SIGTERM, signal.SIGINT)
old_handlers = {signum: signal.signal(signum, forward_signal) for signum in forwarded_signals}
try:
    if received_signal:
        exit_code = 128 + received_signal
    else:
        child = subprocess.Popen([sys.executable, "-m", "agent_tools.slurm", *sys.argv[1:]])
        if received_signal and child.poll() is None:
            child.send_signal(received_signal)
        exit_code = child.wait()
        if exit_code < 0:
            exit_code = 128 + abs(exit_code)
        if received_signal and exit_code == 0:
            exit_code = 128 + received_signal
except BaseException:
    traceback.print_exc()
    exit_code = 128 + received_signal if received_signal else 2
finally:
    for signum, handler in old_handlers.items():
        signal.signal(signum, handler)
if exit_code != 0 and not Path(result_path).exists():
    write_terminal(exit_code)
raise SystemExit(exit_code)
