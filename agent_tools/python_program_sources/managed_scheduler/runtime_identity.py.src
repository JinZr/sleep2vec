from concurrent.futures import ThreadPoolExecutor
from functools import partial
import hashlib
import importlib
import importlib.util
import inspect
import json
from pathlib import Path
import socket
import subprocess
import sys

module = sys.argv[1]
expected = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
artifacts = json.loads(sys.argv[3]) if len(sys.argv) > 3 else []
required_capabilities = json.loads(sys.argv[4]) if len(sys.argv) > 4 else []
planned_commit = sys.argv[5] if len(sys.argv) > 5 else ""
git_commands = [
    ["git", "rev-parse", "HEAD"],
    ["git", "rev-parse", "--show-toplevel"],
    ["git", "status", "--porcelain", "--untracked-files=no"],
    ["git", "ls-files", "--others", "--exclude-standard", "--", "*.py", "*.pyi", "*.pyc", "*.so"],
    ["git", "ls-files", "--others", "--ignored", "--exclude-standard", "--", "*.py", "*.pyi", "*.pyc", "*.so"],
]
# Ordered results preserve diagnostic priority while independent repository scans overlap.
with ThreadPoolExecutor(max_workers=3) as executor:
    commit, repo_root, dirty, untracked_code, ignored_code = executor.map(
        partial(subprocess.run, text=True, capture_output=True), git_commands
    )
if (
    commit.returncode != 0
    or repo_root.returncode != 0
    or dirty.returncode != 0
    or untracked_code.returncode != 0
    or ignored_code.returncode != 0
):
    print(
        commit.stderr or repo_root.stderr or dirty.stderr or untracked_code.stderr or ignored_code.stderr,
        file=sys.stderr,
    )
    raise SystemExit(2)
if dirty.stdout.strip():
    print("Target runtime has tracked worktree changes; launch requires a clean commit.", file=sys.stderr)
    raise SystemExit(2)

runtime_repo_root = Path(repo_root.stdout.strip()).resolve()
if planned_commit:
    planned = subprocess.run(
        ["git", "rev-parse", "--verify", f"{planned_commit}^{{commit}}"],
        cwd=runtime_repo_root,
        text=True,
        capture_output=True,
    )
    if planned.returncode != 0:
        print("Planned runtime commit does not resolve to a commit in the target repository.", file=sys.stderr)
        raise SystemExit(2)
    if planned.stdout.strip().lower() != planned_commit.lower():
        print("Planned runtime commit is not the repository's canonical full object ID.", file=sys.stderr)
        raise SystemExit(2)


def importable_code(output):
    paths = []
    for raw in output.splitlines():
        path = Path(raw)
        if path.suffix == ".pyc":
            if (
                "__pycache__" not in path.parts
                and path.stem.isidentifier()
                and all(part.isidentifier() for part in path.parts[:-1])
                and not (runtime_repo_root / path).with_suffix(".py").exists()
            ):
                paths.append(raw)
            continue
        module_name = path.name.split(".", 1)[0]
        if module_name.isidentifier() and all(part.isidentifier() for part in path.parts[:-1]):
            paths.append(raw)
    return paths


if importable_code(untracked_code.stdout) or importable_code(ignored_code.stdout):
    print(
        "Target runtime has untracked or ignored Python code; launch requires commit-defined import roots.",
        file=sys.stderr,
    )
    raise SystemExit(2)
if (
    not isinstance(required_capabilities, list)
    or len(required_capabilities) != len(set(required_capabilities))
    or any(not isinstance(capability, str) for capability in required_capabilities)
):
    print("Target runtime capability request is invalid.", file=sys.stderr)
    raise SystemExit(2)


def runtime_module(name):
    try:
        owner = importlib.import_module(name)
        origin = Path(owner.__file__).resolve()
        origin.relative_to(runtime_repo_root)
        return owner
    except (AttributeError, ImportError, TypeError, ValueError):
        return None


def has_capability(capability):
    try:
        if capability == "commit_run_start":
            owner = runtime_module("agent_tools.experiment_workspace")
            return callable(getattr(owner, "commit_run_start", None))
        if capability == "runtime_lock":
            owner = runtime_module("agent_tools.runtime_lock")
            return callable(getattr(owner, "runtime_lock", None))
        if capability == "slurm_runtime_lock_fd":
            owner = runtime_module("agent_tools.slurm")
            worker = getattr(owner, "run_frozen_job", None)
            return callable(worker) and "runtime_lock_fd" in inspect.signature(worker).parameters
        if capability == "slurm_bootstrap_signal_handoff":
            owner = runtime_module("agent_tools.slurm")
            return getattr(owner, "BOOTSTRAP_SIGNAL_HANDOFF", None) is True
    except (TypeError, ValueError):
        return False
    return False


spec = importlib.util.find_spec(module)
origin = Path(spec.origin).resolve() if spec is not None and spec.origin else None
if origin is None:
    print(f"Target runtime module has no file origin: {module}", file=sys.stderr)
    raise SystemExit(2)
try:
    origin.relative_to(runtime_repo_root)
except ValueError:
    print(f"Target runtime module is outside the verified repository: {origin}", file=sys.stderr)
    raise SystemExit(2)
missing_capabilities = [capability for capability in required_capabilities if not has_capability(capability)]
if missing_capabilities:
    print(
        "Target runtime lacks managed launch capabilities: " + ", ".join(missing_capabilities),
        file=sys.stderr,
    )
    raise SystemExit(2)
payload = {
    "python": sys.executable,
    "python_version": sys.version.split()[0],
    "runtime_commit": commit.stdout.strip(),
    "runtime_repo_root": str(runtime_repo_root),
    "runtime_hostname": socket.gethostname(),
    "module": module,
    "module_origin": str(origin),
}
stable_identity_fields = (
    "python",
    "python_version",
    "runtime_repo_root",
    "runtime_hostname",
    "module",
    "module_origin",
)
# Commit drift is expected for a rolling checkout; payload still records the commit seen at this process start.
changed = [field for field in stable_identity_fields if expected and payload[field] != expected.get(field)]
if changed:
    print("Target runtime identity changed before process start: " + ", ".join(changed), file=sys.stderr)
    raise SystemExit(2)
for artifact in artifacts:
    path = Path(artifact["path"])
    if path.is_symlink() or not path.is_file() or path.stat().st_nlink != 1:
        print(f"Frozen run artifact is not an independent file: {path}", file=sys.stderr)
        raise SystemExit(2)
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if digest != artifact["sha256"]:
        print(f"Frozen run artifact changed before process start: {path}", file=sys.stderr)
        raise SystemExit(2)
print(json.dumps(payload, sort_keys=True))
