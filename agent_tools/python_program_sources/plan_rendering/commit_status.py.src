import sys; from agent_tools.experiment_workspace import merge_run_manifest; rows = merge_run_manifest(sys.argv[1], [{'step_id': sys.argv[2], 'run_id': sys.argv[3], 'status': sys.argv[4]}]); row = next((row for row in rows if row.get('step_id') == sys.argv[2] and row.get('run_id') == sys.argv[3]), None); (row is not None and row.get('status') == sys.argv[4]) or sys.exit('Canonical run status did not commit as ' + sys.argv[4])