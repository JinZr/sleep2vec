
import json
import os
import sys

path = sys.argv[1]
try:
    os.lstat(path)
except FileNotFoundError:
    print("null")
    raise SystemExit(44)
except OSError as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)

try:
    with open(path, encoding="utf-8", newline="") as file_obj:
        text = file_obj.read()
except (OSError, UnicodeError) as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)

print(json.dumps(text))
