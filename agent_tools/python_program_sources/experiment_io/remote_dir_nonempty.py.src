
import os
import sys

path = sys.argv[1]
try:
    os.lstat(path)
except FileNotFoundError:
    raise SystemExit(44)
except OSError as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)

try:
    entries = os.listdir(path)
except OSError as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)

if entries:
    print("nonempty")
